@page "/room/{RoomId:guid}"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using StoryPoints.Data
@using StoryPoints.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject RoomCoordinator Coordinator
@inject CircuitMemberTracker Tracker
@inject ProtectedLocalStorage Storage
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IOptionsMonitor<RoomLimitOptions> RoomLimits
@implements IAsyncDisposable

<PageTitle>@RoomDisplayName</PageTitle>

@if (room is null)
{
    <div class="container mt-5">
        @if (notFound)
        {
            <div class="alert alert-warning">Ce salon n'existe pas. <a href="/">Retour à l'accueil</a></div>
        }
        else
        {
            <p class="text-muted">Chargement…</p>
        }
    </div>
}
else if (removed)
{
    <div class="container mt-5" style="max-width: 480px;">
        <div class="alert alert-warning">
            Vous avez été retiré du salon par un autre participant.
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="RejoinAsync">Rejoindre à nouveau</button>
            <a class="btn btn-outline-secondary" href="/">Retour à l'accueil</a>
        </div>
    </div>
}
else if (!joined)
{
    <div class="container mt-5" style="max-width: 480px;">
        <h2>Rejoindre le salon</h2>
        <p class="text-muted small">
            Échelle : @ScaleProvider.Label(room.Scale) · Délai max :
            @(room.MaxVoteDurationSeconds is { } s ? $"{s} s" : "illimité")
        </p>
        <EditForm Model="this" OnValidSubmit="JoinAsync">
            <div class="mb-3">
                <label class="form-label">Votre nom</label>
                <InputText class="form-control" @bind-Value="memberName" autofocus />
            </div>
            @if (roomFull)
            {
                <div class="alert alert-warning py-2 mt-2">
                    Ce salon est complet (@(state?.MaxMembers ?? RoomLimits.CurrentValue.MaxMembersPerRoom) membres maximum).
                </div>
            }
            <button type="submit" class="btn btn-primary w-100" disabled="@(string.IsNullOrWhiteSpace(memberName) || roomFull)">
                Rejoindre
            </button>
        </EditForm>
    </div>
}
else if (state is not null)
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-truncate">
                <h4 class="mb-0 text-truncate" title="@RoomDisplayName">@RoomDisplayName</h4>
                <small class="text-muted">
                    Tour @state.Round · Échelle : @ScaleProvider.Label(state.Scale) · Délai max :
                    @(state.MaxVoteDuration is { } d ? $"{(int)d.TotalSeconds} s" : "illimité")
                </small>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm @(showSettings ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleSettings">
                    ⚙ Paramètres
                </button>
                <button class="btn btn-sm @(IsMeAfk ? "btn-warning" : "btn-outline-warning")" @onclick="ToggleAfk">
                    @(IsMeAfk ? "Je reviens" : "Je suis AFK")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyShareUrlAsync">
                    @(copied ? "URL copiée ✓" : "Copier l'URL du salon")
                </button>
            </div>
        </div>

        @if (showSettings)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-title">Paramètres du salon</h6>
                    <div class="mb-3">
                        <label class="form-label">Nom du salon</label>
                        <input class="form-control" @bind="editName" maxlength="60" placeholder="@RoomId.ToString()" />
                        <div class="form-text">Laissez vide pour utiliser l'identifiant du salon par défaut.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Échelle de chiffrage</label>
                        <select class="form-select" @bind="editScale">
                            @foreach (var sc in Enum.GetValues<Scale>())
                            {
                                <option value="@sc">@ScaleProvider.Label(sc) — @string.Join(", ", ScaleProvider.Cards(sc))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Délai max pour voter (à partir du premier vote)</label>
                        <select class="form-select" @bind="editMaxVoteSeconds">
                            @foreach (var option in MaxVoteOptions)
                            {
                                <option value="@option.Seconds">@option.Label</option>
                            }
                        </select>
                    </div>
                    @if (editScale != state.Scale)
                    {
                        <div class="alert alert-warning py-2">
                            Changer l'échelle réinitialise le tour en cours : les votes déjà saisis seront effacés.
                        </div>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="SaveSettingsAsync">Enregistrer</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => showSettings = false)">Annuler</button>
                    </div>
                </div>
            </div>
        }

        @* Bandeau chrono à hauteur fixe : toujours présent pendant le tour pour que la
           zone de chiffrage en dessous ne se décale jamais (évite les miss-clicks). *@
        @if (!state.Revealed)
        {
            <div class="chrono-band mb-3">
                @if (state.CountdownDeadlineUtc is { } cDeadline)
                {
                    var remaining = Math.Max(0, (int)Math.Ceiling((cDeadline - DateTime.UtcNow).TotalSeconds));
                    <div class="alert alert-info">
                        <span>Révélation dans</span>
                        <span class="fs-3 fw-bold">@remaining</span>
                    </div>
                }
                else if (state.VoteDeadlineUtc is { } vDeadline)
                {
                    var remaining = Math.Max(0, (int)Math.Ceiling((vDeadline - DateTime.UtcNow).TotalSeconds));
                    <div class="alert alert-secondary">
                        <span>⏱ Délai du tour</span>
                        <span class="fw-bold">@remaining s</span>
                    </div>
                }
                else if (state.MaxVoteDuration is { } maxDur)
                {
                    <div class="alert alert-secondary opacity-75">
                        <span>⏱ Délai du tour</span>
                        <span class="fw-bold">@((int)maxDur.TotalSeconds) s</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-light text-body-secondary">
                        En attente des votes…
                    </div>
                }
            </div>
        }

        @{
            var revealedResults = state.Revealed ? state.ResultsIfRevealed() : null;
            string VoteBadgeClass(string? vote)
            {
                if (vote is null || revealedResults is null) return "text-bg-secondary";
                if (revealedResults.Min == revealedResults.Max) return "text-bg-secondary";
                if (vote == revealedResults.Min) return "bg-success";
                if (vote == revealedResults.Max) return "bg-danger";
                return "text-bg-secondary";
            }
        }

        <div class="row g-4">
            <div class="col-md-4">
                <h6>Membres (@members.Count)</h6>
                <ul class="list-group">
                    @foreach (var m in members)
                    {
                        var isMe = m.Id == memberId;
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="@(m.IsAfk ? "text-muted fst-italic" : "")">
                                @m.Name
                                @if (isMe) { <span class="text-muted small">(vous)</span> }
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                @if (m.IsAfk)
                                {
                                    <span class="badge bg-secondary">AFK</span>
                                }
                                else if (state.Revealed)
                                {
                                    <span class="badge @VoteBadgeClass(m.Vote)">@(m.Vote ?? "—")</span>
                                }
                                else if (m.HasVoted)
                                {
                                    <span class="badge bg-success">a voté</span>
                                }
                                else
                                {
                                    <span class="badge border text-body-secondary">en attente</span>
                                }
                                @if (!isMe)
                                {
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Actions sur @m.Name">
                                        <button type="button" class="btn btn-outline-warning py-0 px-1"
                                                title="@(m.IsAfk ? $"Réactiver {m.Name}" : $"Marquer {m.Name} comme AFK")"
                                                @onclick="@(() => ToggleMemberAfk(m))">
                                            @(m.IsAfk ? "▶" : "💤")
                                        </button>
                                        <button type="button" class="btn btn-outline-danger py-0 px-1"
                                                title="Retirer @m.Name du salon"
                                                @onclick="@(() => RemoveMember(m))">
                                            ✕
                                        </button>
                                    </div>
                                }
                            </span>
                        </li>
                    }
                </ul>
            </div>

            <div class="col-md-8">
                @if (state.Revealed)
                {
                    var results = revealedResults;
                    @if (results is not null)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Résultats</h5>
                                @if (results.NumericVoteCount > 0)
                                {
                                    <div class="row text-center">
                                        <div class="col">
                                            <div class="text-muted small">Min</div>
                                            <div class="display-6">@results.Min</div>
                                        </div>
                                        <div class="col">
                                            <div class="text-muted small">Médiane</div>
                                            <div class="display-4 text-primary">@results.Median</div>
                                        </div>
                                        <div class="col">
                                            <div class="text-muted small">Max</div>
                                            <div class="display-6">@results.Max</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">Aucune valeur numérique votée.</p>
                                }

                                @if (results.SpecialBreakdown.Count > 0)
                                {
                                    <hr />
                                    <div class="d-flex gap-2 flex-wrap">
                                        @foreach (var c in results.SpecialBreakdown)
                                        {
                                            <span class="badge bg-secondary">@c.Card × @c.Count</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <button class="btn btn-primary" @onclick="NewRound">Nouveau tour</button>
                }
                else
                {
                    <h6>Votre vote</h6>
                    @if (IsMeAfk)
                    {
                        <p class="text-muted">Vous êtes AFK — cliquez sur « Je reviens » pour pouvoir voter.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var card in ScaleProvider.Cards(state.Scale))
                            {
                                var selected = card == myVote;
                                <button class="btn @(selected ? "btn-primary" : "btn-outline-secondary") vote-card"
                                        @onclick="@(() => SubmitVote(card))">
                                    @card
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid RoomId { get; set; }

    private Room? room;
    private bool notFound;

    private RoomState? state;
    private bool joined;
    private Guid memberId = Guid.NewGuid();
    private string memberName = string.Empty;
    private bool roomFull;
    private bool removed;

    private IReadOnlyList<MemberView> members = Array.Empty<MemberView>();
    private string? myVote;
    private bool copied;

    private bool showSettings;
    private Scale editScale;
    private int? editMaxVoteSeconds;
    private string editName = string.Empty;

    private string RoomDisplayName => state?.DisplayName ?? RoomId.ToString();

    private record VoteDurationOption(int? Seconds, string Label);

    private static readonly VoteDurationOption[] MaxVoteOptions =
    {
        new VoteDurationOption(20, "20 secondes"),
        new VoteDurationOption(30, "30 secondes"),
        new VoteDurationOption(40, "40 secondes"),
        new VoteDurationOption(60, "60 secondes"),
        new VoteDurationOption(null, "Illimité")
    };

    private System.Threading.Timer? countdownTimer;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        room = await db.Rooms.FirstOrDefaultAsync(r => r.Id == RoomId);
        if (room is null)
        {
            notFound = true;
            return;
        }

        var maxDuration = room.MaxVoteDurationSeconds is { } sec
            ? TimeSpan.FromSeconds(sec)
            : (TimeSpan?)null;

        state = Coordinator.GetOrCreate(RoomId, room.Scale, maxDuration, room.Name);
        state.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || room is null) return;

        try
        {
            var result = await Storage.GetAsync<string>("memberName");
            if (result.Success && !string.IsNullOrWhiteSpace(result.Value))
            {
                memberName = result.Value!;
            }
        }
        catch
        {
            // ProtectedLocalStorage indisponible : on ignore.
        }

        StateHasChanged();
    }

    private async Task JoinAsync()
    {
        if (state is null) return;
        memberName = memberName.Trim();
        if (memberName.Length == 0) return;

        try
        {
            await Storage.SetAsync("memberName", memberName);
        }
        catch { /* ignore */ }

        if (!state.Join(memberId, memberName))
        {
            roomFull = true;
            return;
        }

        roomFull = false;
        Tracker.Track(RoomId, memberId, memberName);
        joined = true;
        RefreshLocal();
    }

    private void SubmitVote(string card)
    {
        if (state is null) return;
        state.Vote(memberId, card);
        RefreshLocal();
    }

    private void NewRound()
    {
        state?.ResetRound();
        RefreshLocal();
    }

    private bool IsMeAfk => members.FirstOrDefault(m => m.Id == memberId)?.IsAfk ?? false;

    private void ToggleAfk()
    {
        state?.SetAfk(memberId, !IsMeAfk);
        RefreshLocal();
    }

    // Any member can flip another member's AFK state — handy when someone's client
    // froze mid-round and is blocking the reveal. Reversible: "Réactiver" clears it.
    private void ToggleMemberAfk(MemberView m)
    {
        state?.SetAfk(m.Id, !m.IsAfk);
        RefreshLocal();
    }

    // Harder action: drop the member from the live room entirely. Reuses Leave, so the
    // reveal threshold is re-evaluated immediately. The removed member finds out via
    // RefreshLocal (they're no longer in the snapshot) and is shown the "removed" view.
    private void RemoveMember(MemberView m)
    {
        state?.Leave(m.Id);
        RefreshLocal();
    }

    private async Task RejoinAsync()
    {
        removed = false;
        await JoinAsync();
    }

    private void ToggleSettings()
    {
        if (!showSettings && state is not null)
        {
            // Pré-remplit le formulaire avec la config vivante courante.
            editName = state.Name ?? string.Empty;
            editScale = state.Scale;
            editMaxVoteSeconds = state.MaxVoteDuration is { } d ? (int)d.TotalSeconds : null;
        }
        showSettings = !showSettings;
    }

    // Tout membre peut reconfigurer le salon. On persiste dans SQLite (durable) puis on
    // applique à l'état vivant partagé, ce qui notifie tous les membres via Changed.
    private async Task SaveSettingsAsync()
    {
        if (state is null || room is null) return;

        var trimmedName = string.IsNullOrWhiteSpace(editName) ? null : editName.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.Rooms.FirstOrDefaultAsync(r => r.Id == RoomId);
        if (stored is not null)
        {
            stored.Name = trimmedName;
            stored.Scale = editScale;
            stored.MaxVoteDurationSeconds = editMaxVoteSeconds;
            await db.SaveChangesAsync();
        }

        room.Name = trimmedName;
        room.Scale = editScale;
        room.MaxVoteDurationSeconds = editMaxVoteSeconds;

        var duration = editMaxVoteSeconds is { } s ? TimeSpan.FromSeconds(s) : (TimeSpan?)null;
        state.UpdateSettings(editScale, duration, trimmedName);

        showSettings = false;
        RefreshLocal();
    }

    private async Task CopyShareUrlAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
        }
        catch { /* clipboard indisponible */ }

        copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        copied = false;
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            roomFull = false;
            RefreshLocal();
            StateHasChanged();
        });
    }

    private void RefreshLocal()
    {
        if (state is null) return;
        members = state.Snapshot();
        myVote = state.GetMyVote(memberId);

        // I was joined but I'm no longer in the snapshot → another member removed me.
        // Untrack first, otherwise a circuit reconnection (OnConnectionUp) would silently
        // re-add me and undo the removal.
        if (joined && !removed && members.All(m => m.Id != memberId))
        {
            removed = true;
            Tracker.Untrack(RoomId, memberId);
        }

        UpdateCountdownTimer();
    }

    private void UpdateCountdownTimer()
    {
        bool needsTimer = state is not null
            && !removed
            && !state.Revealed
            && (state.CountdownDeadlineUtc is not null || state.VoteDeadlineUtc is not null);

        if (needsTimer && countdownTimer is null)
        {
            countdownTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromMilliseconds(250), TimeSpan.FromMilliseconds(250));
        }
        else if (!needsTimer && countdownTimer is not null)
        {
            countdownTimer.Dispose();
            countdownTimer = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (state is not null)
        {
            state.Changed -= OnStateChanged;
            if (joined)
            {
                Tracker.Untrack(RoomId, memberId);
                state.Leave(memberId);
            }
        }
        if (countdownTimer is not null)
        {
            await countdownTimer.DisposeAsync();
            countdownTimer = null;
        }
    }
}
